{
  "manifest_version": 3,
  "name": "Hoseki Bridge",
  "version": "0.2.0",
  "description": "Bridges free web chat UIs (GLM, Kimi, DeepSeek) to a local Hoseki daemon.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": { "default_popup": "popup.html", "default_title": "Hoseki" },
  "content_scripts": [
    {
      "matches": [
        "https://chat.z.ai/*",
        "https://*.z.ai/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://www.kimi.com/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hoseki@local",
      "strict_min_version": "115.0"
    }
  }
}