{
  "manifest_version": 3,
  "name": "Hoseki Bridge",
  "version": "0.3.0",
  "description": "Bridges free web chat UIs (GLM, Kimi, DeepSeek) to a local Hoseki daemon.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": { "default_popup": "popup.html", "default_title": "Hoseki" },
  "content_scripts": [
    {
      "matches": [
        "https://chat.z.ai/*",
        "https://*.z.ai/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://kimi.ai/*",
        "https://*.kimi.ai/*",
        "https://www.kimi.com/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}